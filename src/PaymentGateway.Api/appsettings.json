{
  "ConnectionStrings": {
    "Default": "Data Source=paymentgateway.db"
  },
  "Gateway": {
    "FeeBps": 250,
    "RateLimitPerMinute": 100
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
